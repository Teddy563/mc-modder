{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fal": {
      "type": "streamable-http",
      "url": "https://mcp.fal.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${FAL_KEY}"
      }
    },
    "minecraft-dev": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mcdxai/minecraft-dev-mcp@1.3.0"
      ]
    }
  }
}
